<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Deterministic offline PCM rendering and encoded file sinks for Heresy.</Description>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NAudio.SoundFile" Version="3.1.0" />
		<PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.win-arm64" Version="1.2.2" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.linux-x64" Version="1.2.2.1" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.linux-arm64" Version="1.2.2.1" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.osx-x64" Version="1.2.2" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.osx-arm64" Version="1.2.2" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Heresy.Render\Heresy.Render.csproj" />
	</ItemGroup>

</Project>
