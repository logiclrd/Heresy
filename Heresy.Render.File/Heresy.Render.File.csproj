<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Deterministic offline PCM rendering and encoded file sinks for Heresy.</Description>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<_SndFileRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_SndFileRid>
		<_SndFileRid Condition="'$(_SndFileRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_SndFileRid>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NAudio.SoundFile" Version="3.1.0" />
		<PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" GeneratePathProperty="true" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.win-arm64" Version="1.2.2" GeneratePathProperty="true" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.linux-x64" Version="1.2.2.1" GeneratePathProperty="true" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.linux-arm64" Version="1.2.2.1" GeneratePathProperty="true" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.osx-x64" Version="1.2.2" GeneratePathProperty="true" PrivateAssets="all" />
		<PackageReference Include="org.sndfile.runtime.osx-arm64" Version="1.2.2" GeneratePathProperty="true" PrivateAssets="all" />
	</ItemGroup>

	<!--
		The runtime packages deliberately contain both static and shared builds.
		Select only the shared objects for the active/cross-target RID and mark
		them as normal project output so they flow through ProjectReference into
		the executable/test host just like other runtime content.
	-->
	<ItemGroup Condition="'$(_SndFileRid)' == 'linux-x64'">
		<None Include="$(Pkgorg_sndfile_runtime_linux_x64)/runtimes/linux-x64/native/*.so"
			Link="%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(_SndFileRid)' == 'linux-arm64'">
		<None Include="$(Pkgorg_sndfile_runtime_linux_arm64)/runtimes/linux-arm64/native/*.so"
			Link="%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(_SndFileRid)' == 'win-x64'">
		<None Include="$(Pkgorg_sndfile_runtime_win_x64)/runtimes/win-x64/native/*.dll"
			Link="%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(_SndFileRid)' == 'win-arm64'">
		<None Include="$(Pkgorg_sndfile_runtime_win_arm64)/runtimes/win-arm64/native/*.dll"
			Link="%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(_SndFileRid)' == 'osx-x64'">
		<None Include="$(Pkgorg_sndfile_runtime_osx_x64)/runtimes/osx-x64/native/*.dylib"
			Link="%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(_SndFileRid)' == 'osx-arm64'">
		<None Include="$(Pkgorg_sndfile_runtime_osx_arm64)/runtimes/osx-arm64/native/*.dylib"
			Link="%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
			CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Heresy.Render\Heresy.Render.csproj" />
	</ItemGroup>

</Project>
