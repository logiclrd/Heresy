<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>SDL3 realtime audio output backend for Heresy.</Description>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SDL3-CS" Version="3.4.18" />
		<PackageReference Include="SDL3-CS.Windows" Version="3.4.18" />
		<PackageReference Include="SDL3-CS.Linux" Version="3.4.18" />
		<PackageReference Include="SDL3-CS.MacOS" Version="3.4.18" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Heresy.Render\Heresy.Render.csproj" />
	</ItemGroup>

</Project>
