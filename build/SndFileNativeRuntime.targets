<Project>

	<PropertyGroup>
		<_SndFileRuntimeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_SndFileRuntimeRid>
		<_SndFileRuntimeRid Condition="'$(_SndFileRuntimeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_SndFileRuntimeRid>

		<_SndFileRuntimeGlob Condition="'$(_SndFileRuntimeRid)' == 'linux-x64'">$(NuGetPackageRoot)org.sndfile.runtime.linux-x64/1.2.2.1/runtimes/linux-x64/native/*.so</_SndFileRuntimeGlob>
		<_SndFileRuntimeGlob Condition="'$(_SndFileRuntimeRid)' == 'linux-arm64'">$(NuGetPackageRoot)org.sndfile.runtime.linux-arm64/1.2.2.1/runtimes/linux-arm64/native/*.so</_SndFileRuntimeGlob>
		<_SndFileRuntimeGlob Condition="'$(_SndFileRuntimeRid)' == 'win-x64'">$(NuGetPackageRoot)org.sndfile.runtime.win-x64/1.2.2/runtimes/win-x64/native/*.dll</_SndFileRuntimeGlob>
		<_SndFileRuntimeGlob Condition="'$(_SndFileRuntimeRid)' == 'win-arm64'">$(NuGetPackageRoot)org.sndfile.runtime.win-arm64/1.2.2/runtimes/win-arm64/native/*.dll</_SndFileRuntimeGlob>
		<_SndFileRuntimeGlob Condition="'$(_SndFileRuntimeRid)' == 'osx-x64'">$(NuGetPackageRoot)org.sndfile.runtime.osx-x64/1.2.2/runtimes/osx-x64/native/*.dylib</_SndFileRuntimeGlob>
		<_SndFileRuntimeGlob Condition="'$(_SndFileRuntimeRid)' == 'osx-arm64'">$(NuGetPackageRoot)org.sndfile.runtime.osx-arm64/1.2.2/runtimes/osx-arm64/native/*.dylib</_SndFileRuntimeGlob>
	</PropertyGroup>

	<Target Name="CopyHeresySndFileRuntimeToOutput"
		AfterTargets="Build"
		Condition="'$(_SndFileRuntimeGlob)' != ''">
		<ItemGroup>
			<_HeresySndFileRuntime Include="$(_SndFileRuntimeGlob)" />
		</ItemGroup>
		<Copy SourceFiles="@(_HeresySndFileRuntime)"
			DestinationFolder="$(TargetDir)"
			SkipUnchangedFiles="true" />

		<!--
			The Linux NuGet contains shared libraries under unversioned file
			names, while the binaries themselves request their ELF SONAMEs.
			NuGet cannot preserve the original symlink farm, so reproduce those
			names as ordinary copies beside the executable.
		-->
		<Copy Condition="$([System.String]::Copy('$(_SndFileRuntimeRid)').StartsWith('linux-'))"
			SourceFiles="$(TargetDir)libsndfile.so;$(TargetDir)libvorbisenc.so;$(TargetDir)libFLAC.so;$(TargetDir)libopus.so;$(TargetDir)libmp3lame.so;$(TargetDir)libvorbis.so;$(TargetDir)libogg.so"
			DestinationFiles="$(TargetDir)libsndfile.so.1;$(TargetDir)libvorbisenc.so.2.0.12;$(TargetDir)libFLAC.so.12;$(TargetDir)libopus.so.0;$(TargetDir)libmp3lame.so.0;$(TargetDir)libvorbis.so.0.4.9;$(TargetDir)libogg.so.0"
			SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyHeresySndFileRuntimeToPublish"
		AfterTargets="Publish"
		Condition="'$(_SndFileRuntimeGlob)' != ''">
		<ItemGroup>
			<_HeresySndFileRuntimePublish Include="$(_SndFileRuntimeGlob)" />
		</ItemGroup>
		<Copy SourceFiles="@(_HeresySndFileRuntimePublish)"
			DestinationFolder="$(PublishDir)"
			SkipUnchangedFiles="true" />
		<Copy Condition="$([System.String]::Copy('$(_SndFileRuntimeRid)').StartsWith('linux-'))"
			SourceFiles="$(PublishDir)libsndfile.so;$(PublishDir)libvorbisenc.so;$(PublishDir)libFLAC.so;$(PublishDir)libopus.so;$(PublishDir)libmp3lame.so;$(PublishDir)libvorbis.so;$(PublishDir)libogg.so"
			DestinationFiles="$(PublishDir)libsndfile.so.1;$(PublishDir)libvorbisenc.so.2.0.12;$(PublishDir)libFLAC.so.12;$(PublishDir)libopus.so.0;$(PublishDir)libmp3lame.so.0;$(PublishDir)libvorbis.so.0.4.9;$(PublishDir)libogg.so.0"
			SkipUnchangedFiles="true" />
	</Target>

</Project>
